+fn selftest_invalid_pointer_deref() -> u8 {
+    // A null raw pointer is a textbook invalid-pointer source; dereferencing it is
+    // Undefined Behaviour and exactly what rust/access-invalid-pointer flags.
+    let p: *const u8 = std::ptr::null();
+    unsafe { *p }
+}
