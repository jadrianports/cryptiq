+      # CI-08 selftest (DELETE post red-run capture): a genuinely multi-line pwsh
+      # `run:` block. The guard is set first (required for it to take effect at
+      # all), then a deliberately failing `cargo build` appears as a NON-FINAL
+      # command, followed by a trailing command that would otherwise succeed.
+      # Proves the non-final failure propagates (turns the step RED) instead of
+      # being swallowed by pwsh's default last-command-only $LASTEXITCODE check.
+      - name: "CI-08 selftest: multi-line pwsh block, non-final cargo build failure must propagate"
+        shell: pwsh
+        run: |
+          $PSNativeCommandUseErrorActionPreference = $true
+          cargo build --release --manifest-path apps/native-host/Cargo.toml --this-flag-does-not-exist
+          Write-Host "UNREACHABLE if propagation works — the cargo build above must have failed the step"
+
   node:
     name: node
     runs-on: windows-2025
