# Refuse to install if the lockfile is out of sync.
# Backstop for CI; locally a developer running `pnpm install` from a clean checkout
# should still work because the lockfile is committed.
frozen-lockfile=true

# Don't auto-execute postinstall scripts from unknown packages.
# Only the explicitly-allowed packages in `pnpm.onlyBuiltDependencies` (root package.json)
# will run lifecycle scripts. Source: pnpm 10 release notes.
ignore-scripts=true
