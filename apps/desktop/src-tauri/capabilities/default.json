{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "cryptiq-main",
  "description": "Cryptiq main window — vault file IO, config IO, clipboard write/clear, dialogs. Literal-path fs scopes only; defends GHSA-6mv3-wm7j-h4w5.",
  "windows": ["main"],
  "platforms": ["windows", "macOS"],
  "permissions": [
    "core:default",

    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-clear",

    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPCONFIG/cryptiq/config.json" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.1" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.2" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.3" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.4" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.5" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.lock" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPCONFIG/cryptiq/config.json" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.tmp" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.1" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.2" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.3" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.4" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.5" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.lock" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPCONFIG/cryptiq/config.json" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.1" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.2" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.3" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.4" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.5" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.lock" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.tmp" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.1" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.2" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.3" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.4" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.5" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.lock" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.tmp" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPCONFIG/cryptiq" },
        { "path": "$APPCONFIG/cryptiq/vaults" }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.1" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.2" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.3" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.4" },
        { "path": "$APPCONFIG/cryptiq/vaults/vault.cryptiq.bak.5" }
      ]
    }
  ]
}
