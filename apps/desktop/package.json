{
  "name": "@cryptiq/desktop",
  "version": "3.2.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bridge": "tauri dev --config src-tauri/tauri.mcp-bridge.conf.json",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "stage:nmhost": "node scripts/copy-nmhost-binary.mjs",
    "tauri:build": "pnpm stage:nmhost && tauri build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:components": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@cryptiq/core": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.1.7",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.5.2",
    "@vitest/browser": "^3.2.4",
    "playwright": "1.58.2",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.1.7",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.4",
    "vitest-browser-svelte": "^1.1.0"
  }
}
