{
  "name": "cryptiq",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r build && pnpm --filter ./apps/desktop tauri:build",
    "dev": "pnpm --filter ./apps/desktop tauri dev",
    "lint": "eslint . && pnpm run lint:custom",
    "lint:custom": "node scripts/lint/run-all.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "format": "prettier --write .",
    "demo:02-1": "node --experimental-transform-types --import ./scripts/demo/_loader.mjs scripts/demo/02-1-calibration.mjs",
    "demo:02-2": "node --experimental-transform-types --import ./scripts/demo/_loader.mjs scripts/demo/02-2-envelope.mjs",
    "demo:02-3": "node --experimental-transform-types --import ./scripts/demo/_loader.mjs scripts/demo/02-3-vault-format.mjs",
    "demo:02-4": "node --experimental-transform-types --import ./scripts/demo/_loader.mjs scripts/demo/02-4-recovery.mjs",
    "demo:02-5": "node --experimental-transform-types --import ./scripts/demo/_loader.mjs scripts/demo/02-5-migration.mjs",
    "demo:02-6": "node --experimental-transform-types --import ./scripts/demo/_loader.mjs scripts/demo/02-6-full-round-trip.mjs"
  },
  "devDependencies": {
    "@opengsd/gsd-core": "1.4.3",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.17.1",
    "prettier": "^3.3.0",
    "svelte-eslint-parser": "^1.6.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@cryptiq/core": "workspace:^"
  }
}
